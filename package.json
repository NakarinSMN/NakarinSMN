{
  "name": "smn-lib",
  "version": "1.0.0",
  "description": "SMN React UI Component Library — Toast, Modal, SpeedDial with Tailwind CSS & React Icons",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/index.css --minify",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "react-icons": "^5.3.0"
  },
  "keywords": [
    "react",
    "ui",
    "tailwind",
    "toast",
    "modal",
    "speeddial",
    "smn"
  ],
  "license": "MIT"
}
